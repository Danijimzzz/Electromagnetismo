 "Falta ${nom}": "Il manque : ${nom}",
 "${N} debe ser un número": "",
 "${N} no puede ser negativa": "",
 "${N} debe ser mayor que 0": "",
 "El factor de idealidad suele estar entre 1 y 2": "",
