 "Como $1 \"${ua.s}\" = ${n(ua.f)} \"${M.base}\"$: $${n(vb)} \"${M.base}\" · (1 \"${ua.s}\")/(${n(ua.f)} \"${M.base}\") = ${n(res)} \"${ua.s}\"$.": "Since $1 \"${ua.s}\" = ${n(ua.f)} \"${M.base}\"$: $${n(vb)} \"${M.base}\" · (1 \"${ua.s}\")/(${n(ua.f)} \"${M.base}\") = ${n(res)} \"${ua.s}\"$.",
