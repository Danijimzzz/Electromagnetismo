      "permanent": true
    },
    {
      "source": "/laboratorio/alterna",
      "destination": "/circuitos/simulador/",
      "permanent": true
    },
    {
      "source": "/laboratorio/alterna/",
      "destination": "/circuitos/simulador/",
      "permanent": true
    },
    {
      "source": "/laboratorio/circuitos",
      "destination": "/circuitos/simulador/",
      "permanent": true
    },
    {
      "source": "/laboratorio/circuitos/",
      "destination": "/circuitos/simulador/",
      "permanent": true
    },
    {
      "source": "/circuitos/continua",
      "destination": "/circuitos/simulador/",
      "permanent": true
    },
    {
      "source": "/circuitos/continua/",
      "destination": "/circuitos/simulador/",
      "permanent": true
    },
    {
      "source": "/circuitos/alterna",
      "destination": "/circuitos/simulador/",
      "permanent": true
    },
    {
      "source": "/circuitos/alterna/",
      "destination": "/circuitos/simulador/",
      "permanent": true
    },
    {
      "source": "/circuitos/transitorios",
      "destination": "/circuitos/simulador/",
      "permanent": true
    },
    {
      "source": "/circuitos/transitorios/",
      "destination": "/circuitos/simulador/",
      "permanent": true
    }
